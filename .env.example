# Copy to .env and fill in. Never commit .env. Explained in docs/04-ENVIRONMENT-VARIABLES.md
# Names only here. No real values belong in this file.

# For anything real (Docker, a server, real calls): DEMO_MODE=false, a SESSION_SECRET of 32 or more random characters, an OWNER_PASSWORD_HASH and a POSTGRES_PASSWORD.
# Core
APP_NAME=ringlark
DATABASE_URL=sqlite:///./ringlark.sqlite3
SESSION_SECRET=change-me-to-a-long-random-string
MODE=draft
DEMO_MODE=true
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
HANDOFF_DIR=./handoff
SEED_DIR=
MAX_BODY_BYTES=26214400

# Sign in (make the hash with: .venv/bin/python tools/hash_password.py, or on Docker: docker compose run --rm --no-deps api python /app/tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# Who the messages come from. Set the first two before MODE=live outside demo mode; until then the app stays in draft mode.
COMPANY_NAME=Your Company
COMPANY_ADDRESS=
BOOKING_URL=
APPOINTMENT_NAME=

# Which adapter each job uses: seed is offline and safe
TELEPHONY_ADAPTER=seed
VOICE_ADAPTER=seed
SMS_ADAPTER=seed
CALENDAR_ADAPTER=seed
CRM_ADAPTER=seed
EMAIL_ADAPTER=seed

# Where Ultravox and Telnyx reach this app (the public address of the API, https)
PUBLIC_BASE_URL=
TOOL_TOKEN_SECRET=

# Phone calls and texts (telnyx), fill in together
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_BASE_URL=https://api.telnyx.com

# Voice engine (ultravox), fill in together
ULTRAVOX_API_KEY=
ULTRAVOX_WEBHOOK_SECRET=
ULTRAVOX_BASE_URL=https://api.ultravox.ai

# Calendar (calcom), fill in together
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com
CALCOM_SLOTS_VERSION=2024-09-04
CALCOM_BOOKINGS_VERSION=2026-02-25

# CRM (twenty), fill in together
TWENTY_BASE_URL=
TWENTY_API_KEY=

# Email (smtp_imap), fill in together
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
EMAIL_FROM=calls@example.test

# Rules. These are the shipped defaults (a decided starting point, not legal advice). Change them to your own rules.
DEFAULT_WINDOW_START=9
DEFAULT_WINDOW_END=17
DEFAULT_DAILY_CAP=50
ALLOW_EXTENDED_HOURS=false
ALLOWED_CALLING_COUNTRIES=+1
FOLLOW_UPS_NEED_APPROVAL=true
HUMAN_TRANSFER_HOURS=09:00-17:00
OFFICE_TIMEZONE=America/New_York
SMS_WINDOW_START=8
SMS_WINDOW_END=21
MAX_INBOUND_CALLS=5
MAX_INBOUND_PER_NUMBER_HOUR=6
# A custom greeting must say it is an AI and, while this is true, that the call may be recorded (transcripts are always stored).
RECORDING_NOTICE_REQUIRED=true
# Transcripts, summaries and follow up messages of finished calls older than this many days are deleted every day. 0 keeps them for ever.
RETENTION_DAYS=365

# Language model for the simulator and summaries: LLM_BACKEND is offline (default, no account), fixture or anthropic.
# anthropic needs a key and is UNVERIFIED against the real service. LLM_MODE=live is the older way to ask for anthropic.
LLM_BACKEND=offline
LLM_MODE=fixture
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
LLM_MODEL=
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
LLM_THINKING=default
LLM_FIXTURES_DIR=
LLM_RECORD=false
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Web app
API_BASE_URL=http://127.0.0.1:8000

# Docker compose only (letters and digits only, or percent-encoded; make one with: openssl rand -hex 24)
POSTGRES_PASSWORD=
