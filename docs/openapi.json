 "components": {
  "schemas": {
   "ActivateIn": {
    "properties": {
     "version_id": {
      "type": "integer",
      "title": "Version Id"
     }
    },
    "type": "object",
    "required": [
     "version_id"
    ],
    "title": "ActivateIn"
   },
   "AdvanceIn": {
    "properties": {
     "hours": {
      "type": "number",
      "maximum": 720.0,
      "minimum": 0.0,
      "title": "Hours"
     }
    },
    "type": "object",
    "required": [
     "hours"
    ],
    "title": "AdvanceIn"
   },
   "CampaignIn": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 2,
      "title": "Name"
     },
     "agent_id": {
      "type": "integer",
      "title": "Agent Id"
     },
     "number_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Number Id"
     },
     "window_start_hour": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 23.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Window Start Hour"
     },
     "window_end_hour": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 24.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Window End Hour"
     },
     "daily_cap": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 5000.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Daily Cap"
     },
     "max_attempts": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Max Attempts",
      "default": 3
     },
     "retry_gap_days": {
      "type": "integer",
      "maximum": 14.0,
      "minimum": 1.0,
      "title": "Retry Gap Days",
      "default": 1
     },
     "allow_voicemail": {
      "type": "boolean",
      "title": "Allow Voicemail",
      "default": false
     },
     "voicemail_text": {
      "type": "string",
      "maxLength": 600,
      "title": "Voicemail Text",
      "default": ""
     },
     "ivr_policy": {
      "type": "string",
      "pattern": "^(hangup|press_once)$",
      "title": "Ivr Policy",
      "default": "hangup"
     },
     "ivr_extension": {
      "type": "string",
      "maxLength": 4,
      "title": "Ivr Extension",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "name",
     "agent_id"
    ],
    "title": "CampaignIn"
   },
   "ChecklistIn": {
    "properties": {
     "step": {
      "type": "string",
      "pattern": "^(caller_id_registered|stir_shaken_attestation|a2p_10dlc_brand|a2p_10dlc_campaign|recording_notice_reviewed)$",
      "title": "Step"
     },
     "done": {
      "type": "boolean",
      "title": "Done"
     }
    },
    "type": "object",
    "required": [
     "step",
     "done"
    ],
    "title": "ChecklistIn"
   },
   "DecideIn": {
    "properties": {
     "approve": {
      "type": "boolean",
      "title": "Approve"
     },
     "note": {
      "type": "string",
      "maxLength": 500,
      "title": "Note",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "approve"
    ],
    "title": "DecideIn"
   },
